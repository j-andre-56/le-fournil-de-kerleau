<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- ===== SEO / ONGLET ===== -->
  <title>Portfolio - Le Fournil de Kerleau</title>
  <meta name="description" content="Portfolio du Fournil de Kerleau à Crac'h - Pains au levain, four bois, cuisson solaire.">

  <!-- ===== POLICE ===== -->
  <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: #F2E8CF;
      color: #000;
      font-family: 'Source Code Pro', monospace;
    }

    /* ===== CONTENU ===== */
    .container {
      max-width: 550px;
      padding: 30px 30px 80px;
    }

    /* Lien retour */
    .back {
      display: inline-block;
      margin-bottom: 30px;
      color: #000;
      font-size: 14px;
      text-transform: uppercase;
    }

    h1 {
      margin: 0 0 12px;
      font-size: 14px;
      font-weight: 700;
    }

    .sub { font-size: 14px; }

    /* Titre section */
    h2 {
      margin: 50px 0 12px;
      padding-top: 12px;
      border-top: 1px solid #000;
      font-size: 14px;
      font-weight: 700;
    }

    /* ===== GRILLE PORTFOLIO ===== */
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    /* Pour ajouter une photo, copie tout le bloc <figure>...</figure> */
    figure { margin: 0; }

    figure img {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border: 1px solid #000;
      background: #fff;
    }

    figcaption {
      margin-top: 8px;
      font-size: 12px;
      line-height: 1.5;
      text-transform: uppercase;
    }

    figcaption span {
      display: block;
      opacity: .6;
      text-transform: none;
    }

    /* Sur petit écran : 1 colonne */
    @media (max-width: 420px) {
      .grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <main class="container">

    <!-- ===== RETOUR ACCUEIL ===== -->
    <a class="back" href="index.html"><<< RETOUR</a>

    <!-- ===== TITRE ===== -->
    <h1>PORTFOLIO</h1>
    <div class="sub">Le Fournil de Kerleau / Crac'h</div>

    <!-- ===== SECTION : PAINS ===== -->
    <h2>01 / PAINS</h2>
    <div class="grid">

      <!-- PHOTO 01 : change juste src="..." et le texte -->
      <figure>
        <img src="assets/pain-quotidien.jpg" alt="Pain Quotidien">
        <figcaption>01 / Quotidien<span>T80, levain, cuisson bois</span></figcaption>
      </figure>

      <!-- PHOTO 02 -->
      <figure>
        <img src="assets/pain-special.jpg" alt="Pain spécial">
        <figcaption>02 / Spécial<span>Recette de la semaine</span></figcaption>
      </figure>

    </div>

    <!-- ===== SECTION : FOUR / FOURNÉE ===== -->
    <h2>02 / FOUR & FOURNÉE</h2>
    <div class="grid">

      <!-- PHOTO 03 -->
      <figure>
        <img src="assets/four-bois.jpg" alt="Four à bois">
        <figcaption>03 / Four Bois<span>Chauffe au bois</span></figcaption>
      </figure>

      <!-- PHOTO 04 -->
      <figure>
        <img src="assets/fournee.jpg" alt="Fournée">
        <figcaption>04 / Fournée<span>Vendredi, sortie du four</span></figcaption>
      </figure>

    </div>

    <!-- ===== SECTION : FAÇONNAGE ===== -->
    <h2>03 / FAÇONNAGE</h2>
    <div class="grid">

      <!-- PHOTO 05 -->
      <figure>
        <img src="assets/faconnage.jpg" alt="Façonnage">
        <figcaption>05 / Façonnage<span>Tour de main</span></figcaption>
      </figure>

      <!-- PHOTO 06 -->
      <figure>
        <img src="assets/levain.jpg" alt="Levain">
        <figcaption>06 / Levain<span>Fermentation lente</span></figcaption>
      </figure>

    </div>

  </main>

</body>
</html>